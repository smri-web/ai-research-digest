GEMINI_API_KEY=...
BUTTONDOWN_API_KEY=...
# Optional: a free Semantic Scholar API key raises the rate limit so it stops getting throttled.
# Request one at https://www.semanticscholar.org/product/api. Leave blank to run without it.
SEMANTIC_SCHOLAR_API_KEY=
# Your published site base, used to build "full breakdown" links in the email:
SITE_BASE_URL=https://YOUR_GITHUB_USERNAME.github.io/ai-research-digest

# Optional: only for the local "email a preview to myself" mode (python -m main --selftest).
# These stay on your laptop (this file is git-ignored) and are NOT used by the weekly job.
GMAIL_ADDRESS=smrikesavan@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
TEST_RECIPIENT=smrikesavan@gmail.com
